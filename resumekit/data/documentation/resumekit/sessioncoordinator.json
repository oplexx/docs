))","await coordinator.didReceive(.heartbeatAck)","\/\/ ...","","\/\/ 3. On WebSocket close:","await coordinator.connectionDidClose(error: someError)","","\/\/ 4. On user logout:","await coordinator.clearSession()"],"syntax":"swift"},{"type":"heading","level":1,"text":"Subscribing to events","anchor":"Subscribing-to-events"},{"code":["Task {","  for await event in await coordinator.events {","    switch event {","    case .replayStarted:           muteNotifications()","    case .replayFinished:          unmuteNotifications()","    case .sessionInvalidated(let r, _):","      Log.warn(\"session invalidated: \\(r)\")","    case .stateChanged(let s):     Log.info(\"state → \\(s)\")","    }","  }","}"],"syntax":"swift","type":"codeListing"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/resumekit\/sessioncoordinator"]}],"metadata":{"externalID":"s:9ResumeKit18SessionCoordinatorC","roleHeading":"Class","symbolKind":"class","modules":[{"name":"ResumeKit"}],"fragments":[{"text":"class","kind":"keyword"},{"kind":"text","text":" "},{"text":"SessionCoordinator","kind":"identifier"}],"navigatorTitle":[{"text":"SessionCoordinator","kind":"identifier"}],"role":"symbol","title":"SessionCoordinator"},"references":{"doc://ResumeKit/documentation/ResumeKit/SessionCoordinator/Configuration":{"identifier":"doc:\/\/ResumeKit\/documentation\/ResumeKit\/SessionCoordinator\/Configuration","navigatorTitle":[{"kind":"identifier","text":"Configuration"}],"url":"\/documentation\/resumekit\/sessioncoordinator\/configuration","abstract":[{"type":"text","text":"Tuning knobs. Defaults match Discord Gateway’s recommended values"},{"type":"text","text":" "},{"text":"and work out of the box with most server implementations.","type":"text"}],"kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Configuration","kind":"identifier"}],"title":"SessionCoordinator.Configuration","type":"topic","role":"symbol"},"doc://ResumeKi