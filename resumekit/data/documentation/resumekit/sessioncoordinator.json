{"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/ResumeKit\/documentation\/ResumeKit\/SessionCoordinator"},"abstract":[{"type":"text","text":"Discord-style session-resume client. Runs as an actor so callers don’t"},{"type":"text","text":" "},{"text":"have to worry about thread-safety; you can poke it from your transport","type":"text"},{"type":"text","text":" "},{"type":"text","text":"task and from the main actor freely."}],"relationshipsSections":[{"title":"Conforms To","type":"conformsTo","identifiers":["doc:\/\/ResumeKit\/s8SendableP","doc:\/\/ResumeKit\/ScA","doc:\/\/ResumeKit\/12_Concurrency8AnyActorP"],"kind":"relationships"}],"kind":"symbol","primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"actor"},{"text":" ","kind":"text"},{"kind":"identifier","text":"SessionCoordinator"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"kind":"content","content":[{"level":1,"type":"heading","text":"Architecture","anchor":"Architecture"},{"inlineContent":[{"text":"The coordinator owns three pieces of state:","type":"text"}],"type":"paragraph"},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The in-memory "},{"code":"state","type":"codeVoice"},{"type":"text","text":" (handshaking \/ replaying \/ live \/ disconnected)."}]}]},{"content":[{"inlineContent":[{"text":"A persistent ","type":"text"},{"type":"codeVoice","code":"(sessionId, lastSeq)"},{"type":"text","text":" cursor in "},{"type":"codeVoice","code":"SessionStorage"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"A heartbeat timer that fires while the connection is healthy.","type":"text"}]}]}]},{"inlineContent":[{"text":"It does ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"not"}]},{"text":" own the connection itself — that’s your transport’s","type":"text"},{"text":" ","type":"text"},{"text":"problem. T