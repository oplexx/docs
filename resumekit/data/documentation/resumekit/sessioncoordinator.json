{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/ResumeKit\/documentation\/ResumeKit\/SessionCoordinator"},"abstract":[{"type":"text","text":"Discord-style session-resume client. Runs as an actor so callers don’t"},{"text":" ","type":"text"},{"text":"have to worry about thread-safety; you can poke it from your transport","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"task and from the main actor freely."}],"sections":[],"relationshipsSections":[{"kind":"relationships","title":"Conforms To","type":"conformsTo","identifiers":["doc:\/\/ResumeKit\/s8SendableP","doc:\/\/ResumeKit\/ScA","doc:\/\/ResumeKit\/12_Concurrency8AnyActorP"]}],"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"actor"},{"text":" ","kind":"text"},{"text":"SessionCoordinator","kind":"identifier"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"kind":"content","content":[{"anchor":"Architecture","text":"Architecture","level":1,"type":"heading"},{"type":"paragraph","inlineContent":[{"text":"The coordinator owns three pieces of state:","type":"text"}]},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"text":"The in-memory ","type":"text"},{"type":"codeVoice","code":"state"},{"type":"text","text":" (handshaking \/ replaying \/ live \/ disconnected)."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"A persistent "},{"type":"codeVoice","code":"(sessionId, lastSeq)"},{"type":"text","text":" cursor in "},{"code":"SessionStorage","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"A heartbeat timer that fires while the connection is healthy.","type":"text"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"text":"It does ","type":"text"},{"type":"strong","inlineContent":[{"text":"not","type":"text"}]},{"type":"text","text":" own the connection itself — that’s your transport’s"},{"text":" ","type":"text"},{"type":"text","