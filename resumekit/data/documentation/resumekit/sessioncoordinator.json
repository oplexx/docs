seven calls you’ll make)","level":1,"anchor":"Lifecycle-the-seven-calls-youll-make","type":"heading"},{"syntax":"swift","type":"codeListing","code":["\/\/ 1. On WebSocket connect:","await coordinator.connectionDidOpen()","       \/\/ → coordinator decides Identify vs Resume from storage,","       \/\/   asks transport to send the chosen handshake frame.","","\/\/ 2. On every incoming frame your decoder parses:","await coordinator.didReceive(.ready(sessionId: \"abc\", initialSeq: 0))","await coordinator.didReceive(.pushEvent(seq: 17))","await coordinator.didReceive(.heartbeatAck)","\/\/ ...","","\/\/ 3. On WebSocket close:","await coordinator.connectionDidClose(error: someError)","","\/\/ 4. On user logout:","await coordinator.clearSession()"]},{"text":"Subscribing to events","type":"heading","level":1,"anchor":"Subscribing-to-events"},{"code":["Task {","  for await event in await coordinator.events {","    switch event {","    case .replayStarted:           muteNotifications()","    case .replayFinished:          unmuteNotifications()","    case .sessionInvalidated(let r, _):","      Log.warn(\"session invalidated: \\(r)\")","    case .stateChanged(let s):     Log.info(\"state → \\(s)\")","    }","  }","}"],"syntax":"swift","type":"codeListing"}]}],"abstract":[{"text":"Discord-style session-resume client. Runs as an actor so callers don’t","type":"text"},{"type":"text","text":" "},{"type":"text","text":"have to worry about thread-safety; you can poke it from your transport"},{"type":"text","text":" "},{"type":"text","text":"task and from the main actor freely."}],"variants":[{"paths":["\/documentation\/resumekit\/sessioncoordinator"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/ResumeKit\/documentation\/ResumeKit\/SessionCoordinator"},"hierarchy":{"paths":[["doc:\/\/ResumeKit\/documentation\/ResumeKit"]]},"topicSections":[{"title":"Structures","identifiers":["doc:\/\/ResumeKit\/documentation\/ResumeKit\/SessionC