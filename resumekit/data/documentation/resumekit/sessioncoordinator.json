{"schemaVersion":{"minor":3,"patch":0,"major":0},"hierarchy":{"paths":[["doc:\/\/ResumeKit\/documentation\/ResumeKit"]]},"abstract":[{"type":"text","text":"Discord-style session-resume client. Runs as an actor so callers don’t"},{"text":" ","type":"text"},{"text":"have to worry about thread-safety; you can poke it from your transport","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"task and from the main actor freely."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"actor","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"SessionCoordinator"}],"platforms":["macOS"],"languages":["swift"]}]},{"content":[{"text":"Architecture","type":"heading","level":1,"anchor":"Architecture"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The coordinator owns three pieces of state:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The in-memory ","type":"text"},{"code":"state","type":"codeVoice"},{"text":" (handshaking \/ replaying \/ live \/ disconnected).","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"A persistent "},{"code":"(sessionId, lastSeq)","type":"codeVoice"},{"type":"text","text":" cursor in "},{"code":"SessionStorage","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"A heartbeat timer that fires while the connection is healthy."}],"type":"paragraph"}]}],"type":"orderedList"},{"inlineContent":[{"type":"text","text":"It does "},{"inlineContent":[{"type":"text","text":"not"}],"type":"strong"},{"type":"text","text":" own the connection itself — that’s your transport’s"},{"text":" ","type":"text"},{"type":"text","text":"problem. The coordinator just decides what to send when you tell it"},{"text":" ","type":"text"},{"type":"text","text":"“the connection is open” or “I received this frame”."}],"type":"paragraph"},{"type":"heading","level":1,"text":"Lifecycle (the seven calls you’ll make)","anchor":"Lifecycle-the-seven-calls-youll-make"},{"syntax":"swift","type":"codeListing","code":["\/\/ 1. On WebSocket connect:","await coordinator.connectionDidOpen()","       \/\/ → coordinator decides Identify vs Resume from storage,","       \/\/   asks transport to send the chosen handshake frame.","","\/\/ 2. On every incoming frame your decoder parses:","await coordinator.didReceive(.ready(sessionId: \"abc\", initialSeq: 0))","await coordinator.didReceive(.pushEvent(seq: 17))","await coordinator.didReceive(.heartbeatAck)","\/\/ ...","","\/\/ 3. On WebSocket close:","await coordinator.connectionDidClose(error: someError)","","\/\/ 4. On user logout:","await coordinator.clearSession()"]},{"type":"heading","text":"Subscribing to events","anchor":"Subscribing-to-events","level":1},{"code":["Task {","  for await event in await coordinator.events {","    switch event {","    case .replayStarted:           muteNotifications()","    case .replayFinished:          unmuteNotifications()","    case .sessionInvalidated(let r, _):","      Log.warn(\"session invalidated: \\(r)\")","    case .stateChanged(let s):     Log.info(\"state → \\(s)\")","    }","  }","}"],"syntax":"swift","type":"codeListing"}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/ResumeKit\/documentation\/ResumeKit\/SessionCoordinator"},"kind":"symbol","sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/resumekit\/sessioncoordinator"]}],"relationshipsSections":[{"identifiers":["doc:\/\/ResumeKit\/s8SendableP","doc:\/\/ResumeKit\/ScA","doc:\/\/ResumeKit\/12_Concurrency8AnyActorP"],"kind":"relationships","type":"conformsTo","title":"Conforms To"}],"topicSections":[{"identifiers":["doc:\/\/ResumeKit\/documentation\/ResumeKit\/SessionCoordinator\/Configuration"],"title":"Structures"},{"identifiers":["doc:\/\/ResumeKit\/documentation\/ResumeKit\/SessionCoordinator\/init(transport:storage:token:clientProperties:configu