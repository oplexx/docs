{"variants":[{"paths":["\/documentation\/resumekit\/sessioncoordinator"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"kind":"symbol","abstract":[{"type":"text","text":"Discord-style session-resume client. Runs as an actor so callers don’t"},{"text":" ","type":"text"},{"text":"have to worry about thread-safety; you can poke it from your transport","type":"text"},{"type":"text","text":" "},{"type":"text","text":"task and from the main actor freely."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"actor"},{"kind":"text","text":" "},{"text":"SessionCoordinator","kind":"identifier"}],"languages":["swift"]}]},{"content":[{"type":"heading","level":1,"anchor":"Architecture","text":"Architecture"},{"inlineContent":[{"type":"text","text":"The coordinator owns three pieces of state:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The in-memory "},{"type":"codeVoice","code":"state"},{"type":"text","text":" (handshaking \/ replaying \/ live \/ disconnected)."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"A persistent ","type":"text"},{"code":"(sessionId, lastSeq)","type":"codeVoice"},{"text":" cursor in ","type":"text"},{"type":"codeVoice","code":"SessionStorage"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"A heartbeat timer that fires while the connection is healthy.","type":"text"}]}]}],"type":"orderedList"},{"type":"paragraph","inlineContent":[{"text":"It does ","type":"text"},{"type":"strong","inlineContent":[{"text":"not","type":"text"}]},{"text":" own the connection itself — that’s your transport’s","type":"text"},{"type":"text","text":" "},{"type":"text","text":"problem. The coordinator just decides what to send when you tell it"},{"text":" ","type":"text"},{"type":"text","text":"“the connection is open” or “I received this frame”."