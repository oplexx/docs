{"sections":[],"abstract":[{"type":"text","text":"Discord-style session-resume client. Runs as an actor so callers don’t"},{"text":" ","type":"text"},{"type":"text","text":"have to worry about thread-safety; you can poke it from your transport"},{"text":" ","type":"text"},{"text":"task and from the main actor freely.","type":"text"}],"schemaVersion":{"minor":3,"major":0,"patch":0},"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"actor"},{"kind":"text","text":" "},{"kind":"identifier","text":"SessionCoordinator"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"level":1,"type":"heading","anchor":"Architecture","text":"Architecture"},{"inlineContent":[{"text":"The coordinator owns three pieces of state:","type":"text"}],"type":"paragraph"},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"The in-memory "},{"type":"codeVoice","code":"state"},{"type":"text","text":" (handshaking \/ replaying \/ live \/ disconnected)."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"A persistent ","type":"text"},{"code":"(sessionId, lastSeq)","type":"codeVoice"},{"text":" cursor in ","type":"text"},{"type":"codeVoice","code":"SessionStorage"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A heartbeat timer that fires while the connection is healthy."}]}]}]},{"inlineContent":[{"text":"It does ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"not"}]},{"text":" own the connection itself — that’s your transport’s","type":"text"},{"type":"text","text":" "},{"type":"text","text":"problem. The coordinator just decides what to send when you tell it"},{"type":"text","text":" "},{"type":"text","text":"“the connection is open” or “I received this frame”."}],"type":"paragraph"},{"text":"Lifecycle (the seven calls you’ll make)","type":"heading","anchor":"Lifecycle-the-seven-calls-youll-make","level":1},{"syntax":"swift","type":"codeListing","code":["\/\/ 1. On WebSocket connect:","await coordinator.connectionDidOpen()","       \/\/ → coordinator decides Identify vs Resume from storage,","       \/\/   asks transport to send the chosen handshake frame.","","\/\/ 2. On every incoming frame your decoder parses:","await coordinator.didReceive(.ready(sessionId: \"abc\", initialSeq: 0))","await coordinator.didReceive(.pushEvent(seq: 17))","await coordinator.didReceive(.heartbeatAck)","\/\/ ...","","\/\/ 3. On WebSocket close:","await coordinator.connectionDidClose(error: someError)","","\/\/ 4. On user logout:","await coordinator.clearSession()"]},{"text":"Subscribing to events","level":1,"type":"heading","anchor":"Subscribing-to-events"},{"code":["Task {","  for await event in await coordinator.events {","    switch event {","    case .replayStarted:           muteNotifications()","    case .replayFinished:          unmuteNotifications()","    case .sessionInvalidated(let r, _):","      Log.warn(\"session invalidated: \\(r)\")","    case .stateChanged(let s):     Log.info(\"state → \\(s)\")","    }","  }","}"],"type":"codeListing","syntax":"swift"}],"kind":"content"}],"relationshipsSections":[{"kind":"relationships","type":"conformsTo","identifiers":["doc:\/\/ResumeKit\/s8SendableP","doc:\/\/ResumeKit\/ScA","doc:\/\/ResumeKit\/12_Concurrency8AnyActorP"],"title":"Conforms To"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/resumekit\/sessioncoordinator"]}],"hierarchy":{"paths":[["doc:\/\/ResumeKit\/documentation\/ResumeKit"]]},"metadata":{"navigatorTitle":[{"kind":"identifier","text":"SessionCoordinator"}],"fragments":[{"text":"class","kind":"keyword"},{"kind":"text","text":" "},{"text":"SessionCoordinator","kind":"identifier"}],"symbolKind":"class","roleHeading":"Class","role":"symbol","title":"SessionCoordinator","modules":[{"name":"ResumeKit"}],"externalID":"s:9ResumeKit18SessionCoordinatorC"},"topicSections":[{"title":