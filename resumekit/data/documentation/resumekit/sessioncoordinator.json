{"schemaVersion":{"minor":3,"major":0,"patch":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/resumekit\/sessioncoordinator"]}],"abstract":[{"type":"text","text":"Discord-style session-resume client. Runs as an actor so callers don’t"},{"text":" ","type":"text"},{"type":"text","text":"have to worry about thread-safety; you can poke it from your transport"},{"text":" ","type":"text"},{"text":"task and from the main actor freely.","type":"text"}],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"actor","kind":"keyword"},{"kind":"text","text":" "},{"text":"SessionCoordinator","kind":"identifier"}],"languages":["swift"],"platforms":["macOS"]}],"kind":"declarations"},{"kind":"content","content":[{"type":"heading","anchor":"Architecture","text":"Architecture","level":1},{"inlineContent":[{"type":"text","text":"The coordinator owns three pieces of state:"}],"type":"paragraph"},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The in-memory "},{"type":"codeVoice","code":"state"},{"text":" (handshaking \/ replaying \/ live \/ disconnected).","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"A persistent "},{"type":"codeVoice","code":"(sessionId, lastSeq)"},{"type":"text","text":" cursor in "},{"type":"codeVoice","code":"SessionStorage"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"A heartbeat timer that fires while the connection is healthy."}],"type":"paragraph"}]}]},{"inlineContent":[{"text":"It does ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"not"}]},{"text":" own the connection itself — that’s your transport’s","type":"text"},{"type":"text","text":" "},{"type":"text","text":"problem. The coordinator just decides what to send when you tell it"},{"type":"text","text":" "},{"type":"text","text":"“the connection is open” or “I received this frame”."}],"type":"paragra